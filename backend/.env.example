# Copy this file to .env and adjust for your environment.

# SQLite by default. For production, point this at a persistent volume/path
# (or swap for a Postgres URL, e.g. postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///./zaradera.db

# Render + Neon: set this in Render's environment, never in frontend variables.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require

# Comma-separated list of origins allowed to call this API.
# Set this to your real frontend URL(s) in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,
zaradera-collections-portal.netlify.app

# Maximum workbook size in bytes (10 MiB).
MAX_UPLOAD_BYTES=10485760